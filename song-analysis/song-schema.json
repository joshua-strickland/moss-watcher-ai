{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["track_metadata", "arrangement"],
  "properties": {
    "track_metadata": {
      "type": "object",
      "required": ["artist", "title", "key_signature", "bpm", "time_signature", "genre"],
      "properties": {
        "artist": { "type": "string" },
        "title": { "type": "string" },
        "key_signature": { "type": "string" },
        "bpm": { "type": "integer" },
        "time_signature": { "type": "string" },
        "genre": { "type": "string" }
      }
    },
    "arrangement": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_name", "duration_bars", "elements"],
        "properties": {
          "section_name": { "type": "string" },
          "duration_bars": { "type": "integer" },
          "chord_progression": { "type": "string" },
          "global_transitions": { "type": "string" },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "timing"],
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "Bass",
                    "Drums - Kick",
                    "Drums - Snare",
                    "Drums - Clap",
                    "Drums - Shakers",
                    "Drums - Hats",
                    "Drums - Rides",
                    "Drums - Other Percussive",
                    "Synth - Sustained",
                    "Synth - Pluck",
                    "Synth - Pad",
                    "Synth - Granular Pad",
                    "Synth - Arp",
                    "Synth - Supersaw",
                    "Keys - Piano",
                    "Vocals - Lead",
                    "Vocals - Background",
                    "Vocals - Chop",
                    "Vocals - Atmosphere",
                    "Transition - Sweep",
                    "Transition - Riser",
                    "FX - Foley",
                    "FX - Noise",
                    "FX - Impact",
                    "Guitar - Electric",
                    "Guitar - Acoustic"
                  ]
                },
                "label": { "type": "string" },
                "tonality": { "type": "string" },
                "pattern": { "type": "string" },
                "automation": { "type": "string" },
                "timing": { "type": "string" },
                "pattern_variation": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}